  "code": [
    {
      "path": "src/constraints/skills.rs (PLACEHOLDER)",
      "title": "PLACEHOLDER: technician has the skill",
      "excerpt": "// PLACEHOLDER EXCERPT - not real generated code\npub fn missing_skill(f: &ConstraintFactory) -> Constraint {\n    f.for_each::<Job>()\n        .filter(|job| !job.technician().has_skill(job.skill()))\n        .penalize(HardSoftScore::ONE_HARD)\n        .named(\"missing skill\")\n}"
    },
    {
      "path": "src/constraints/workshop_capacity.rs (PLACEHOLDER)",
      "title": "PLACEHOLDER: at most two buses in the workshop",
      "excerpt": "// PLACEHOLDER EXCERPT - not real generated code\npub fn workshop_capacity(f: &ConstraintFactory) -> Constraint {\n    f.for_each::<Job>()\n        .group_by(|job| job.day(), count_distinct(|job| job.bus()))\n        .filter(|_, buses| *buses > 2)\n        .penalize_by(HardSoftScore::ONE_HARD, |_, buses| buses - 2)\n        .named(\"workshop holds two buses\")\n}"
    },
    {
      "path": "src/constraints/due_day.rs (PLACEHOLDER)",
      "title": "PLACEHOLDER: done before the due day",
      "excerpt": "// PLACEHOLDER EXCERPT - not real generated code\npub fn late_job(f: &ConstraintFactory) -> Constraint {\n    f.for_each::<Job>()\n        .filter(|job| job.day() > job.due_day())\n        .penalize_by(HardSoftScore::ONE_SOFT, |job| job.day() - job.due_day())\n        .named(\"late job\")\n}"
    },
    {
      "path": "src/constraints/parts.rs (PLACEHOLDER)",
      "title": "PLACEHOLDER: parts arrive first",
      "excerpt": "// PLACEHOLDER EXCERPT - not real generated code\npub fn parts_not_in_stock(f: &ConstraintFactory) -> Constraint {\n    f.for_each::<Job>()\n        .join::<Part>(equal(|job| job.part(), |part| part.id()))\n        .filter(|job, part| job.day() < part.arrival_day())\n        .penalize(HardSoftScore::ONE_HARD)\n        .named(\"part not in stock\")\n}"
    }
  ],
